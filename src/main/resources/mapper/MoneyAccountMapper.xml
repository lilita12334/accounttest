<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.accountBook.mapper.MoneyAccountMapper">

    <insert id="addTypeName" >
        insert into category (user_id,type,name,sore_order)
        values (#{user_id},#{type},#{name},#{sore_order})
    </insert>

    <insert id="addAccount" >
        insert into account_record (user_id,category_id,amount,transaction_date,note)
        values (#{user_id},#{category_id},#{amount},#{transaction_date},#{note})
    </insert>
</mapper>
