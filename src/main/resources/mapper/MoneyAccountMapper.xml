<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.accountBook.mapper.MoneyAccountMapper">

    <insert id="addTypeName" >
        insert ignore into category (user_id,type,name,sort_order)
        values (#{user_id},#{type},#{name},#{sort_order})
    </insert>

    <select id="getCategory" resultType="org.accountBook.dto.Category">
        select
            id,
            user_id,
            type,
            name,
            sort_order
        from category
        where user_id=#{id}
        order by type desc, sort_order asc
    </select>

    <insert id="addAccount" >
        insert into account_record (user_id,category_id,amount,transaction_date,note)
        values (#{user_id},#{category_id},#{amount},#{transaction_time},#{note})
    </insert>

    <select id="countTypeByCaId" resultType="int">
        select count(*)
        from account_record
        where category_id=#{id}
    </select>

    <delete id="deleteType">
        delete from category
        where id=#{id}
         and user_id=#{userid}
    </delete>
</mapper>
